			@media (max-width: 480px) {
				.footer-links {
					grid-template-columns: 1fr;
				}
			}

			/* ============ MOTION ============
			   Reusable, site-wide animation system. Targets existing card/section
			   class names directly (see the matching selector list in the script
			   below) so individual pages never need animation-specific markup.
			   Everything here is gated behind prefers-reduced-motion. */
			@media (prefers-reduced-motion: no-preference) {
				/* Scroll-reveal: JS adds .anim-target on observe, .in-view on intersect */
				.anim-target {
					opacity: 0;
					transform: translateY(20px);
					transition:
						opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
						transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
				}

				.anim-target.in-view {
					opacity: 1;
					transform: none;
				}

				/* Hero content: fades up once on load, no scroll trigger needed */
				@keyframes hero-content-in {
					from {
						opacity: 0;
						transform: translateY(16px);
					}
					to {
						opacity: 1;
						transform: none;
					}
				}

				.hero > .hero-container,
				.hero-content,
				.about-hero > .container,
				.join-hero > .container,
				.oca-hero > .container,
				.llm-hero > .container,
				.claw-hero > .container,
				.team-hero > .container,
				.resources-hero > .container,
				.not-found {
					animation: hero-content-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
				}

				/* Hero background: slow ambient drift on the glow blobs */
				@keyframes page-glow-drift-1 {
					0%,
					100% {
						transform: translate(0, 0) scale(1);
					}
					50% {
						transform: translate(30px, -20px) scale(1.08);
					}
				}

				@keyframes page-glow-drift-2 {
					0%,
					100% {
						transform: translate(0, 0) scale(1);
					}
					50% {
						transform: translate(-25px, 25px) scale(1.05);
					}
				}

				.page-hero-glow-1,
				.hero-glow-1 {
					animation: page-glow-drift-1 18s ease-in-out infinite;
				}

				.page-hero-glow-2,
				.hero-glow-2 {
					animation: page-glow-drift-2 22s ease-in-out infinite;
				}
			}

			/* Shared hero background pattern (glow blobs + hairline grid) --
			   markup is added per-page; styling lives here so it stays consistent. */
			.page-hero-bg {
				position: absolute;
				inset: 0;
				z-index: -1;
			}

			.page-hero-glow {
				position: absolute;
				border-radius: 50%;
				filter: blur(90px);
				opacity: 0.1;
			}

			.page-hero-glow-1 {
				top: -10%;
				left: -5%;
				width: 460px;
				height: 460px;
				background: var(--color-primary);
			}

			.page-hero-glow-2 {
				bottom: -20%;
				right: -5%;
				width: 380px;
				height: 380px;
				background: var(--color-accent);
			}

			.page-hero-grid {
				position: absolute;
				inset: 0;
				background-image:
					linear-gradient(var(--color-border) 1px, transparent 1px),
					linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
				background-size: 48px 48px;
				mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 30%, transparent 70%);
				opacity: 0.4;
			}
		</style>
	</body>
