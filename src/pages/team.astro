---
import Base from "../layouts/Base.astro";

// bio: array of blocks -- a string renders as a paragraph, a string[] renders
// as a bulleted list. These are self-submitted by each steward verbatim; do
// not paraphrase or shorten them.
const stewards = [
	{
		initials: "JY",
		handle: "@GTM 🎯",
		name: "Jason “yonks” Younker",
		role: "Founder",
		bio: [
			"A serial entrepreneur and #buildinpublic advocate by practice, I bring experience across real estate, decentralized systems, and cooperative governance. I’m a lifelong technologist with 20 years’ of network engineering before starting a business renting houses and cars and developing a passion for opening up community and ownership for more people. I love building sustainable systems from the ground up, co-founding REtoken | The Real Estate DAO, a decentralized investment club designed to make real estate investing accessible beyond accredited investors and the Triple Win Foundation. I’ve proudly served as co-founder and Chief Digital Alchemist to several web3 and cooperative ventures, designing governance frameworks and community infrastructure.",
