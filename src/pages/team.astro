const credentials = [
	{ label: "Multi-AI Governance Review", value: "Every governance decision is independently checked by 9 AI systems from 6 different companies before it's published — so no single AI's blind spot goes unnoticed." },
	{ label: "Bilingual Terms, Verified", value: "Our English and Chinese (Mandarin) terminology is cross-checked for accuracy, so bilingual students get consistent guidance in both languages." },
	{ label: "Public, Not Private", value: "Every governance decision and financial record we publish is on GitHub, open for anyone to read — not locked away in private company files." },
];
---

<Base
	title="Founding Stewards"
	description="The founding stewards of F1Visa.Net — a team building a student-owned cooperative on proven governance infrastructure. Part of the ♾️ WeOwnNet 🌐 ecosystem."
>
	<section class="team-hero section">
		<div class="container">
			<span class="badge">🛂 F1Visa.Net ♾️ (.OCA)</span>
			<h1>Founding Stewards</h1>
			<p class="lead">
				We're not a VC-funded startup. We're a team of builders, governance
				architects, and community organizers building a student-owned
				cooperative — on proven infrastructure from the
				<strong>♾️ WeOwnNet 🌐 ecosystem</strong>.
			</p>
		</div>
	</section>

	<!-- Stewards Grid -->
	<section class="section">
		<div class="container">
			<div class="stewards-grid">
				{stewards.map((s) => (
					<div class="steward-card">
						<div class="steward-avatar">
							<span>{s.initials}</span>
						</div>
						<div class="steward-info">
							<span class="steward-handle">{s.handle}</span>
							<h3>{s.name}</h3>
							<p class="steward-role">{s.role}</p>
							<div class="steward-bio">
								{s.bio.map((block) =>
									Array.isArray(block) ? (
										<ul>
											{block.map((item) => <li>{item}</li>)}
										</ul>
									) : (
										<p>{block}</p>
									)
								)}
							</div>
							<button type="button" class="steward-bio-toggle" aria-expanded="false">See more</button>
							<div class="steward-tags">
								{s.tags.map((tag) => (
									<span class="tag">{tag}</span>
								))}
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
		<noscript>
			<!-- Astro leaves this style inline (it only hoists/scopes top-level
			     <style> blocks), so these selectors stay unscoped at 0,1,0 while
			     the scoped rules above are 0,2,0 via [data-astro-cid-*].
			     !important is required or these silently lose the cascade and
			     the fallback does nothing. -->
			<style>
				.steward-bio {
					max-height: none !important;
					overflow: visible !important;
				}
				.steward-bio-toggle {
					display: none !important;
				}
			</style>
		</noscript>
	</section>

	<!-- Ecosystem Credentials -->
	<section class="section alt-bg">
		<div class="container">
			<header class="section-header">
				<h2>Built on Proven Governance</h2>
				<p>Our authority comes from the WeOwnNet ecosystem — not from claims, but from verified track records.</p>
			</header>
			<div class="credentials-grid">
				{credentials.map((c) => (
					<div class="credential-card">
						<h3>{c.label}</h3>
						<p>{c.value}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Join CTA -->
	<section class="section">
		<div class="container">
			<div class="cta-banner">
				<h2>Want to Join the Team?</h2>
				<p>
					We're looking for mentors, community builders, and contributors
					who believe in student-owned infrastructure. Founding
					Cooperative Members can grow into leadership roles — including
					MetaCouncil and C-Suite positions.
				</p>
				<a href="https://community.f1visa.net/join" class="btn btn-primary btn-lg">Join the Waitlist</a>
				<a href="/contact" class="btn btn-secondary btn-lg" style="margin-left: var(--spacing-md)">Contact the Team</a>
			</div>
		</div>
	</section>
</Base>

<script>
	// Steward bios collapse to a fixed height so cards with very different
	// bio lengths still form a consistent grid; only show "See more" when a
	// bio actually overflows that collapsed height.
	document.querySelectorAll<HTMLElement>(".steward-bio").forEach((bio) => {
		const toggle = bio.nextElementSibling;
		if (!(toggle instanceof HTMLButtonElement) || !toggle.classList.contains("steward-bio-toggle")) {
			return;
		}
		if (bio.scrollHeight <= bio.clientHeight + 1) {
			toggle.remove();
			return;
		}
		bio.classList.add("collapsible");
		toggle.addEventListener("click", () => {
			const expanded = bio.classList.toggle("expanded");
			toggle.textContent = expanded ? "See less" : "See more";
			toggle.setAttribute("aria-expanded", String(expanded));
		});
	});
</script>

<style>
	.team-hero {
		text-align: center;
		padding-top: var(--spacing-5xl);
		padding-bottom: var(--spacing-3xl);
	}

	.badge {
		display: inline-block;
		padding: var(--spacing-xs) var(--spacing-md);
		margin-bottom: var(--spacing-md);
		font-size: var(--font-size-xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: white;
		background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
		border-radius: var(--radius-full);
	}

	.team-hero h1 {
		font-size: var(--font-size-5xl);
		font-weight: 800;
		letter-spacing: -0.03em;
		margin-bottom: var(--spacing-lg);
		background: linear-gradient(135deg, var(--color-text) 0%, var(--color-primary) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.team-hero .lead {
		font-size: var(--font-size-xl);
		line-height: 1.6;
		color: var(--color-muted);
		max-width: 720px;
		margin: 0 auto;
	}

	.team-hero .lead strong {
		color: var(--color-text);
	}

	.section-header {
		text-align: center;
		max-width: var(--max-width);
		margin: 0 auto var(--spacing-4xl);
	}

	.section-header h2 {
		font-size: var(--font-size-3xl);
		font-weight: 800;
		margin-bottom: var(--spacing-md);
	}

	.section-header p {
		font-size: var(--font-size-lg);
		color: var(--color-muted);
	}

	.alt-bg {
		background: var(--color-surface);
	}

	.stewards-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--spacing-xl);
	}

	.steward-card {
		display: flex;
		gap: var(--spacing-lg);
		padding: var(--spacing-xl);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		transition: border-color var(--transition-base), box-shadow var(--transition-base);
	}

	.steward-card:hover {
		border-color: var(--color-primary-light);
		box-shadow: var(--shadow-lg);
	}

	.steward-avatar {
		flex-shrink: 0;
		width: 64px;
		height: 64px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: var(--font-size-xl);
		font-weight: 800;
		color: white;
		background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
		border-radius: var(--radius-full);
	}

	.steward-info {
		flex: 1;
	}

	.steward-handle {
		font-size: var(--font-size-xs);
		font-weight: 600;
		color: var(--color-primary);
	}

	.steward-info h3 {
		font-size: var(--font-size-lg);
		font-weight: 700;
		margin-bottom: var(--spacing-xs);
	}

	.steward-role {
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-muted);
		margin-bottom: var(--spacing-sm);
	}

	.steward-bio {
		position: relative;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		line-height: 1.6;
		margin-bottom: var(--spacing-md);
		/* Collapsed by default so cards with wildly different bio lengths
		   (a one-line bio next to a multi-paragraph one) still read as a
		   consistent grid instead of some cards towering over others. */
		max-height: 7.5em;
		overflow: hidden;
		transition: max-height var(--transition-base);
	}

	.steward-bio-toggle {
		display: inline-block;
		margin-bottom: var(--spacing-md);
		padding: 0;
		font-size: var(--font-size-xs);
		font-weight: 600;
		color: var(--color-primary);
		background: none;
		border: none;
		cursor: pointer;
	}

	.steward-bio-toggle:hover {
		text-decoration: underline;
	}

	.steward-bio p,
	.steward-bio ul {
		margin-bottom: var(--spacing-sm);
	}

	.steward-bio p:last-child,
	.steward-bio ul:last-child {
		margin-bottom: 0;
	}

	.steward-bio ul {
		padding-left: var(--spacing-lg);
	}

	.steward-bio li {
		margin-bottom: var(--spacing-xs);
	}

	.steward-bio li:last-child {
		margin-bottom: 0;
	}

	.steward-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-xs);
	}

	.tag {
		padding: var(--spacing-xs) var(--spacing-sm);
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-primary-dark);
		background: color-mix(in srgb, var(--color-primary) 15%, transparent);
		border-radius: var(--radius-full);
	}

	/* opacity on the whole element faded text and background toward the same
	   color, so text/background contrast collapsed almost to zero -- tint
	   only the background instead, and use a higher-contrast text variant
	   per theme (dark mode's own --color-primary is too close in luminance
	   to its own wash to read clearly). */
	@media (prefers-color-scheme: dark) {
		:root:not(.light) .tag {
			color: var(--color-primary-light);
			background: color-mix(in srgb, var(--color-primary-dark) 15%, transparent);
		}
	}

	:root.dark .tag {
		color: var(--color-primary-light);
		background: color-mix(in srgb, var(--color-primary-dark) 15%, transparent);
	}

	.credentials-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--spacing-xl);
	}

	.credential-card {
		padding: var(--spacing-xl);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}

	.credential-card h3 {
		font-size: var(--font-size-lg);
		font-weight: 700;
		margin-bottom: var(--spacing-sm);
	}

	.credential-card p {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		line-height: 1.6;
	}

	.cta-banner {
		text-align: center;
		padding: var(--spacing-3xl) var(--spacing-2xl);
		background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
		border-radius: var(--radius-lg);
		color: white;
	}

	.cta-banner h2 {
		font-size: var(--font-size-3xl);
		font-weight: 800;
		margin-bottom: var(--spacing-md);
	}

	.cta-banner p {
		font-size: var(--font-size-lg);
		line-height: 1.6;
		opacity: 0.9;
		max-width: 600px;
		margin: 0 auto var(--spacing-xl);
	}

	.cta-banner .btn-primary {
		background: white;
		color: var(--color-primary);
		border: none;
	}

	.cta-banner .btn-secondary {
		background: transparent;
		color: white;
		border: 2px solid rgba(255, 255, 255, 0.4);
	}

	.cta-banner .btn-secondary:hover {
		border-color: white;
	}

	@media (max-width: 900px) {
		.stewards-grid {
			grid-template-columns: 1fr;
		}

		.credentials-grid {
			grid-template-columns: 1fr;
		}

		.team-hero h1 {
			font-size: var(--font-size-4xl);
		}
	}
</style>

<style is:global>
	/* .expanded/.collapsible are only ever added client-side (steward-bio
	   script above), never written in this file's static markup, so Astro's
	   scoped-style analysis treats them as unused and prunes them from the
	   scoped block. Global styles skip that pruning.
	   Both classes are matched here (rather than .expanded alone) so this
	   rule scores 0,3,0 and outranks the scoped .steward-bio[data-astro-cid]
	   rule at 0,2,0 -- otherwise the two would tie and the winner would
	   depend on stylesheet order. The script always adds .collapsible before
	   .expanded can be toggled, so they co-occur. */
	.steward-bio.collapsible.expanded {
		max-height: 1200px;
	}

	/* .collapsible is only added when JS detects the bio actually overflows
	   its collapsed height, so the fade-out doesn't render on short bios that
	   never got a toggle button. */
	.steward-bio.collapsible:not(.expanded)::after {
		content: "";
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 2.4em;
		background: linear-gradient(to bottom, transparent, var(--color-surface));
		pointer-events: none;
	}
</style>
